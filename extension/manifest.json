{
  "manifest_version": 3,
  "name": "jobpilot - Autofill & Job Application Tracker",
  "version": "0.1.0",
  "description": "Autofills job applications from one profile, warns you before you apply twice, and tells you when a posting comes down.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://jobpilot-api.jobpilot.workers.dev/*",
    "http://localhost:8787/*"
  ],
  "optional_host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.teamtailor.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*",
    "https://*.bamboohr.com/*",
    "https://jobs.jobvite.com/*",
    "https://*.zohorecruit.com/*",
    "https://*.darwinbox.in/*",
    "https://*.keka.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.co.in/*",
    "https://*.foundit.in/*",
    "https://www.instahyre.com/*",
    "https://cutshort.io/*",
    "https://www.hirist.tech/*",
    "https://www.seek.com.au/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://indeed.com/*",
        "https://*.indeed.co.in/*",
        "https://indeed.co.in/*",
        "https://www.naukri.com/*",
        "https://jobpilot-3lg.pages.dev/*",
        "https://*.jobpilot-3lg.pages.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "jobpilot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
