{
  "name": "jobpilot — job application tracker",
  "short_name": "jobpilot",
  "description": "Track every application, autofill the forms, and find out when a posting comes down.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#080d16",
  "theme_color": "#080d16",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Applications",
      "short_name": "Applications",
      "url": "/dashboard/applications",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Profile",
      "short_name": "Profile",
      "url": "/dashboard/profile",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
