# Cache control rules for maximum speed & instant page loads

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # The control that matters most here, because this origin holds the session
  # token in localStorage: anything that manages to execute script on
  # banapply.com can read it. Two live routes to that were found and fixed —
  # stored `javascript:` URLs, and a pdfjs advisory covering the version that
  # parses user-supplied resumes in this very origin — and a third will exist
  # eventually. This is what stops the payload phoning home.
  #
  # Google Analytics needs three entries, not one. The tag in index.html was
  # added long after this allowlist was built for Firebase sign-in, neither
  # file mentioned the other, and the result was that GA had never recorded a
  # single hit in production — the tag sat in the head of every prerendered
  # route and was killed before it ran. Unblocking script-src alone would have
  # looked fixed and still measured nothing, because GA4 posts its hits over
  # connect-src, frequently to a regional host (region1.google-analytics.com).
  # *.googleapis.com does not cover any of it: google-analytics.com is a
  # different registrable domain.
  #
  # This does widen connect-src, which the paragraph below calls the half that
  # blocks exfiltration. Accepted knowingly: once script-src admits Google’s
  # script to this origin it can already read what it likes, so the entry
  # concedes little the tag did not already imply. If analytics is ever
  # dropped, remove all three together.
  #
  # 'unsafe-inline' for script-src is not something to be pleased about; it is
  # required by the inline theme bootstrap that runs before hydration to avoid
  # a flash of the wrong theme. connect-src is the narrow one, and it is the
  # half that blocks exfiltration.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://*.firebaseapp.com https://www.gstatic.com https://www.googletagmanager.com; connect-src 'self' https://api.banapply.com https://*.googleapis.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com https://*.google-analytics.com https://*.analytics.google.com; img-src 'self' data: blob: https://www.google-analytics.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src https://*.firebaseapp.com https://banapply-9da92.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
