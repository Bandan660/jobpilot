# Copy to frontend/.env.local
# Local wrangler dev default. In production set this to your deployed Worker URL.
VITE_API_BASE_URL=http://localhost:8787

# Firebase web config, from Project settings -> Your apps -> Web app.
# None of these are secrets: a Firebase web config ships in every client that
# uses it, and the API key identifies the project rather than authorising
# anything. What protects the data is the ID-token check in the Worker.
#
# Leave them unset and the site falls back to the original email/password
# endpoints, with the Google button hidden — so a build without them still
# works, it just has no Google sign-in and no password reset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
