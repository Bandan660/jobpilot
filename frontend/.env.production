# Committed deliberately. This is not a secret, and leaving it to the Cloudflare
# Pages build variables meant any local `wrangler pages deploy dist` shipped a
# bundle pointing at localhost:8787 — which is exactly what happened once.
VITE_API_BASE_URL=https://api.banapply.com

# Firebase web config. Same reasoning as the API URL above: these must live in
# the committed env file, because deploys ship a locally-built bundle and
# Cloudflare Pages' own build variables never apply.
VITE_FIREBASE_API_KEY=AIzaSyCTym0QpwdJRC_rZ9Gfa4QUA5iMUvFSDr0
VITE_FIREBASE_AUTH_DOMAIN=banapply-9da92.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=banapply-9da92
# Chrome Web Store Published Extension URL
VITE_CHROME_STORE_URL=https://chromewebstore.google.com/detail/jgpbodbfgppaghpfmmhnheemflnfdikb?utm_source=item-share-cb

